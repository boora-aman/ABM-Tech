# =============================================================================
# ABM TECH — environment
# Everything here is OPTIONAL for `npm run dev`. The site is static content;
# these only enable enquiry storage and email notification.
# =============================================================================

# Stores contact-form enquiries. Without it, leads are emailed and written to
# the deployment log instead — a missing database never loses a lead.
MONGODB_URI=
MONGODB_DB=abm_tech

# Email notification. Without it, leads are still stored and logged.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM="ABM Tech <hello@abmtech.in>"
# Where new-enquiry notifications go. Defaults to site.config contact email.
LEAD_NOTIFY_TO=

# --------------------------------------------------- BUSINESS DETAILS --------
# These override src/lib/site.config.ts per environment. Leave blank to keep
# the config-file value.
NEXT_PUBLIC_SITE_URL=https://abmtech.in
NEXT_PUBLIC_LEGAL_NAME=ABM Tech

NEXT_PUBLIC_CONTACT_EMAIL=
# E.164, no spaces — used for tel: links
NEXT_PUBLIC_PHONE_E164=
# Human-readable, for display
NEXT_PUBLIC_PHONE_DISPLAY=
# E.164 without the leading + — wa.me format
NEXT_PUBLIC_WHATSAPP=

# Keep byte-identical to your Google Business Profile — a mismatch between
# your site, your schema and your listings suppresses local ranking.
NEXT_PUBLIC_ADDR_STREET=
NEXT_PUBLIC_ADDR_CITY=Dehradun
NEXT_PUBLIC_ADDR_REGION=Uttarakhand
NEXT_PUBLIC_ADDR_POSTAL=248001
NEXT_PUBLIC_GEO_LAT=30.3165
NEXT_PUBLIC_GEO_LNG=78.0322
# Your Google Business Profile share link
NEXT_PUBLIC_MAPS_URL=

# Blank means that icon is simply not rendered — no dead links. Real defaults
# for the live profiles are already set in src/lib/site.config.ts; only set
# these to override per environment. They also feed Organization `sameAs`.
# Shared with Google IT Solution. Only one of the two sites should list these
# in its Organization schema — see the note in README.md.
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/googleitsolution/
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/people/Google-IT-Solution/61592626603794/
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_GITHUB=
NEXT_PUBLIC_X=
NEXT_PUBLIC_YOUTUBE=

# --------------------------------------------------- REGISTRATION -----------
# Printed on quotations, invoices, proposals and agreements. Defaults live in
# src/lib/site.config.ts; Business details in the admin overrides both.
# Leave GSTIN empty until the business is actually registered — an empty one
# is what makes documents print as "Invoice" rather than "Tax Invoice".
NEXT_PUBLIC_UDYAM=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_PAN=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# CMS — optional. Without MONGODB_URI the site renders from the committed seed
# content in src/lib/content/ and the admin is read-only. With it, everything
# on the site becomes editable at /admin and over the API at /api/v1.
# ---------------------------------------------------------------------------

# Mongo connection string. On the VPS this is the local instance:
MONGODB_URI=mongodb://abm_app:CHANGE_ME@127.0.0.1:27017/abm_tech?authSource=abm_tech
MONGODB_DB=abm_tech

# Auth.js secret. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public origin, used by Auth.js for callback URLs.
NEXTAUTH_URL=https://abmtech.in

# Used once by `npm run seed:admin` to create the first owner, then remove.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
